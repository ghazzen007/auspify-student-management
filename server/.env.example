# Port the API listens on
PORT=5000

# Local MongoDB:      mongodb://127.0.0.1:27017/campus_registry
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus_registry
MONGO_URI=mongodb://127.0.0.1:27017/campus_registry

# Front-end address allowed to call the API in development (optional)
CLIENT_ORIGIN=http://localhost:5173
